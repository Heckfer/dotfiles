#!/usr/bin/env bash

# Backups live in `bkp`, in the private-dotfiles repo and symlinked into
# ~/.local/bin by install.sh — not in here: one implementation, one place to
# fix. `bkp backup sublime` replaces the backup_sublime_tabs function this file
# used to define.

function clean-phone() {
  PHONE=$(echo "$1" | tr -d -c 0-9)
  echo "$PHONE" | pbcopy
  echo "> Phone is in the clipboard"
  echo ""
  echo "$PHONE"
  echo ""
}

function open-task() {
  open https://pjolodevkb.atlassian.net/browse/$1
}

function pair() {
  ip_or_hostname=$1
  if grep "^[a-zA-Z]" < <(echo "$ip_or_hostname"); then
    ip_or_hostname=${ip_or_hostname}.lan
  fi
  open vnc://"$ip_or_hostname"
}

function stop_vpn() {
  launchctl unload /Library/LaunchAgents/com.paloaltonetworks.gp.pangp*
}

function start_vpn() {
  launchctl load /Library/LaunchAgents/com.paloaltonetworks.gp.pangp*
}

function check-dollar-price() {
  local desired_value=4.95
  local response dollar_value_now

  if ! response=$(curl --silent --show-error --fail https://economia.awesomeapi.com.br/last/USD-BRL 2>&1); then
    echo "Could not fetch the exchange rate: $response" >&2
    return 1
  fi

  dollar_value_now=$(printf '%s' "$response" | jq -r '.USDBRL.bid // empty' 2>/dev/null)
  if [ -z "$dollar_value_now" ]; then
    echo "Unexpected API response: $response" >&2
    return 1
  fi

  echo "USD now: R\$ $dollar_value_now (target: R\$ $desired_value)"

  if [ "$(echo "$dollar_value_now >= $desired_value" | bc -l)" -eq 1 ]; then
    echo "Worth it, sell now"
  else
    echo "Not worth it, hold"
  fi
}

function git-pull-all() {
  local dir repo before after output count reason
  for dir in */; do
    # Skip anything that isn't a git repository
    [ -d "${dir}.git" ] || continue

    repo="${dir%/}"
    before=$(git -C "$dir" rev-parse HEAD 2>/dev/null)

    if output=$(git -C "$dir" pull --rebase 2>&1); then
      after=$(git -C "$dir" rev-parse HEAD 2>/dev/null)
      if [ "$before" = "$after" ]; then
        printf '%-40s up to date\n' "$repo"
      else
        count=$(git -C "$dir" rev-list --count "${before}..${after}" 2>/dev/null)
        printf '%-40s updated (%s new commits)\n' "$repo" "$count"
      fi
    else
      # Prefer git's fatal/error line as the reason, else its first line
      reason=$(printf '%s\n' "$output" | grep -m 1 -E '^(fatal|error):')
      [ -n "$reason" ] || reason=$(printf '%s\n' "$output" | head -n 1)
      printf '%-40s FAILED: %s\n' "$repo" "$reason"
    fi
  done
}
