#!/usr/bin/env bash

# Shared helpers for the private backup tree under ~/Documents/bkp.
# Absolute path for the same reason .zshrc's source lines are: a sourced file
# has no portable way to locate its own directory.
source "$HOME/projects/heckfer/dotfiles/sh/.bkp_common"

function clean-phone() {
  PHONE=$(echo "$1" | tr -d -c 0-9)
  echo "$PHONE" | pbcopy
  echo "> Phone is in the clipboard"
  echo ""
  echo "$PHONE"
  echo ""
}

function open-task() {
  open https://pjolodevkb.atlassian.net/browse/$1
}

function pair() {
  ip_or_hostname=$1
  if grep "^[a-zA-Z]" < <(echo "$ip_or_hostname"); then
    ip_or_hostname=${ip_or_hostname}.lan
  fi
  open vnc://"$ip_or_hostname"
}

function stop_vpn() {
  launchctl unload /Library/LaunchAgents/com.paloaltonetworks.gp.pangp*
}

function start_vpn() {
  launchctl load /Library/LaunchAgents/com.paloaltonetworks.gp.pangp*
}

function backup_sublime_tabs() {
  local session_dir="$HOME/Library/Application Support/Sublime Text/Local"
  local category="sublime-session"

  if [ ! -d "$session_dir" ]; then
    echo "Sublime session directory not found: $session_dir" >&2
    return 1
  fi

  bkp_assert_not_in_git || return 1

  local archive
  archive="$(bkp_new_file "$category" ".zip")"

  # Only the live session files. Sublime keeps its own "Backup <name>" copies
  # alongside them, which are stale (often months old) and tripled the archive
  # size. They are excluded, not deleted — they are Sublime's data, not ours.
  if ! (cd "$session_dir" && zip -q "$archive" ./*.sublime_session -x './Backup *'); then
    echo "Failed to archive the Sublime session" >&2
    rm -f "$archive"
    return 1
  fi

  echo "Sublime session backed up to $archive"
  bkp_prune "$category"
}

function check_dollar_price() {
  DOLLAR_VALUE_NOW=$(curl https://economia.awesomeapi.com.br/last/USD-BRL --silent | jq '.USDBRL.ask | tonumber')
  DESIRED_VALUE=4.9500

  echo $DOLLAR_VALUE_NOW
  echo $DESIRED_VALUE

  COMPARISON_RESULT=$(echo "$DESIRED_VALUE >= $DOLLAR_VALUE_NOW" | bc -l)

  # Check the result and print a message
  if [ "$COMPARISON_RESULT" -eq 1 ]; then
    echo "Ta valendo, troca troca troca"
  else
    echo "N ta valendo, nao troca"
  fi
}
